#!/bin/sh
# User-facing facade for cld-gateway Homebrew installation.
#
# Provides high-level commands (setup, doctor) and pass-through to cld-gateway.
# Expected to be invoked from Homebrew-installed location: $(brew --prefix)/bin/cld-gateway-sh
#
# Commands:
#   cld-gateway-sh setup              - Run packaged Python helper to set up user-home files
#   cld-gateway-sh doctor             - Check installation status and health
#   cld-gateway-sh gateway <args>     - Explicit pass-through to cld-gateway
#   cld-gateway-sh <args>             - Pass through unknown subcommands to cld-gateway

set -e

# Locate the script directory (where this script lives, and where packaged assets are)
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Resolve the Python helper path.
# Works in both archive extraction (bin/ sibling to homebrew/) and Homebrew installation.
resolve_python_helper() {
    # Try archive layout first: assume bin/ is sibling to homebrew/
    local archive_path="$(dirname "$SCRIPT_DIR")/homebrew/post_install.py"
    if [ -f "$archive_path" ]; then
        echo "$archive_path"
        return 0
    fi

    # Fall back to formula-scoped Homebrew libexec location
    local formula_prefix
    formula_prefix="$(brew --prefix cld-gateway 2>/dev/null)" || {
        echo "Error: brew not found and archive layout not detected" >&2
        return 1
    }
    local brew_path="$formula_prefix/libexec/post_install.py"
    if [ -f "$brew_path" ]; then
        echo "$brew_path"
        return 0
    fi

    # Neither location exists
    echo "Error: Python helper not found in archive layout or formula-scoped libexec" >&2
    return 1
}

PYTHON_HELPER="$(resolve_python_helper)" || exit 1

# User home paths
USER_HOME="${HOME}"
GATEWAY_HOME="$USER_HOME/.gateway"
CLAUDE_GATEWAY_HOME="$USER_HOME/.claude_gateway"

# Main command dispatch
main() {
    if [ $# -eq 0 ]; then
        # No arguments: pass through to cld-gateway
        exec cld-gateway "$@"
    fi

    case "$1" in
        setup)
            cmd_setup
            ;;
        doctor)
            cmd_doctor
            ;;
        gateway)
            # Explicit pass-through: cld-gateway-sh gateway <args> -> cld-gateway <args>
            shift
            exec cld-gateway "$@"
            ;;
        *)
            # Unknown subcommand: pass through to cld-gateway
            exec cld-gateway "$@"
            ;;
    esac
}

# Setup command: run the packaged Python helper
cmd_setup() {
    if [ ! -f "$PYTHON_HELPER" ]; then
        echo "Error: Packaged Python helper not found: $PYTHON_HELPER" >&2
        exit 1
    fi

    echo "==> Setting up cld-gateway user configuration"
    echo "==> Ensuring ~/.gateway exists"
    echo "==> Ensuring ~/.claude_gateway exists"
    echo "==> Installing config.yml"
    echo "==> Installing settings.json"
    echo "==> Linking shared Claude entries"

    # Run the Python helper with zero arguments; it derives paths internally
    if ! python3 "$PYTHON_HELPER"; then
        echo "Error: Setup failed" >&2
        exit 1
    fi

    echo "==> Setup finished"
    echo
    echo "⚠️  ==================================================== ⚠️"
    echo "⚠️   REQUIRED NEXT STEP 1 - start the service:            ⚠️"
    echo "⚠️                                                        ⚠️"
    echo "⚠️     brew services start cld-gateway                    ⚠️"
    echo "⚠️                                                        ⚠️"
    echo "⚠️   If this is an update or the service was already      ⚠️"
    echo "⚠️   installed before, use instead:                       ⚠️"
    echo "⚠️                                                        ⚠️"
    echo "⚠️     brew services restart cld-gateway                  ⚠️"
    echo "⚠️  ==================================================== ⚠️"
    echo
    echo "⚠️  ==================================================== ⚠️"
    echo "⚠️   REQUIRED NEXT STEP 2 - verify the installation:      ⚠️"
    echo "⚠️                                                        ⚠️"
    echo "⚠️     cld-gateway-sh doctor                               ⚠️"
    echo "⚠️                                                        ⚠️"
    echo "⚠️   This checks installed files and the /health          ⚠️"
    echo "⚠️   endpoint.                                            ⚠️"
    echo "⚠️  ==================================================== ⚠️"
    echo
}

# Doctor command: usability-focused health check
cmd_doctor() {
    echo "==> Checking cld-gateway installation"
    critical_exit_code=0

    # Check critical files (must exist for success)
    if [ -f "$GATEWAY_HOME/config.yml" ]; then
        echo "[OK] Found ~/.gateway/config.yml"
    else
        echo "[FAIL] Missing ~/.gateway/config.yml"
        critical_exit_code=1
    fi

    if [ -f "$CLAUDE_GATEWAY_HOME/settings.json" ]; then
        echo "[OK] Found ~/.claude_gateway/settings.json"
    else
        echo "[FAIL] Missing ~/.claude_gateway/settings.json"
        critical_exit_code=1
    fi

    CODEX_COMMANDS_HOME="$USER_HOME/.codex_gateway/commands"
    if [ -d "$CODEX_COMMANDS_HOME" ]; then
        echo "[OK] Found ~/.codex_gateway/commands"
    else
        echo "[FAIL] Missing ~/.codex_gateway/commands"
        critical_exit_code=1
    fi

    STATUS_ASSET_PATH="$CODEX_COMMANDS_HOME/gateway/plugin/commands/status.md"
    if [ -f "$STATUS_ASSET_PATH" ]; then
        echo "[OK] Found ~/.codex_gateway/commands/gateway/plugin/commands/status.md"
    else
        echo "[FAIL] Missing ~/.codex_gateway/commands/gateway/plugin/commands/status.md"
        critical_exit_code=1
    fi

    MARKETPLACE_MANIFEST="$CODEX_COMMANDS_HOME/gateway/.claude-plugin/marketplace.json"
    if [ -f "$MARKETPLACE_MANIFEST" ]; then
        echo "[OK] Found ~/.codex_gateway/commands/gateway/.claude-plugin/marketplace.json"
    else
        echo "[FAIL] Missing ~/.codex_gateway/commands/gateway/.claude-plugin/marketplace.json"
        critical_exit_code=1
    fi

    if [ -f "$CLAUDE_GATEWAY_HOME/settings.json" ] && grep -q '"gateway@gateway": true' "$CLAUDE_GATEWAY_HOME/settings.json"; then
        echo "[OK] gateway plugin registered in ~/.claude_gateway/settings.json"
    else
        echo "[FAIL] gateway plugin not registered in ~/.claude_gateway/settings.json"
        critical_exit_code=1
    fi

    # Check for representative shared entries (either directory or symlink)
    # These are required; setup creates them, so doctor verifies they exist
    for entry in agents commands skills hooks docs projects; do
        entry_path="$CLAUDE_GATEWAY_HOME/$entry"
        if [ -d "$entry_path" ] || [ -L "$entry_path" ]; then
            echo "[OK] Found ~/.claude_gateway/$entry"
        else
            echo "[FAIL] Missing ~/.claude_gateway/$entry"
            critical_exit_code=1
        fi
    done

    # Verify installed command assets match packaged assets when both are present
    if [ -f "$PYTHON_HELPER" ]; then
        FORMULA_PREFIX="$(dirname "$(dirname "$PYTHON_HELPER")")"
        PACKAGED_COMMANDS_DIR="$FORMULA_PREFIX/libexec/commands"
        if [ -d "$PACKAGED_COMMANDS_DIR" ] && [ -d "$CODEX_COMMANDS_HOME" ]; then
            mismatch_found=0
            for pkg_file in $(find "$PACKAGED_COMMANDS_DIR" -type f); do
                rel_path="${pkg_file#$PACKAGED_COMMANDS_DIR/}"
                installed_file="$CODEX_COMMANDS_HOME/$rel_path"
                if [ ! -f "$installed_file" ]; then
                    echo "[FAIL] Missing installed command asset ~/.codex_gateway/commands/$rel_path"
                    mismatch_found=1
                    continue
                fi
                if ! cmp -s "$installed_file" "$pkg_file"; then
                    echo "[FAIL] Installed command asset ~/.codex_gateway/commands/$rel_path does not match packaged asset"
                    mismatch_found=1
                fi
            done
            if [ $mismatch_found -eq 0 ]; then
                echo "[OK] Installed Codex command assets match packaged assets"
            else
                critical_exit_code=1
            fi
        fi
    fi

    # Resolve listen address from installed config and verify health endpoint
    if [ -f "$GATEWAY_HOME/config.yml" ]; then
        listen_addr="$(awk -F': ' '/^[[:space:]]*listen_addr:[[:space:]]*/ {print $2; exit}' "$GATEWAY_HOME/config.yml" 2>/dev/null || true)"
        if [ -n "$listen_addr" ]; then
            host="${listen_addr%%:*}"
            port="${listen_addr##*:}"
            health_url="http://$listen_addr/health"

            if command -v lsof >/dev/null 2>&1; then
                # lsof's formatted COMMAND column is truncated (commonly to 9
                # chars) and never contains the executable's full path, so a
                # path grep against it can never match - even for our own,
                # genuinely running process. Resolve PIDs via `lsof -t`
                # (untruncated, PID-only output) instead, then resolve each
                # PID's real executable path via `ps -o comm=`, which does
                # return the full path on macOS.
                listen_pids="$(lsof -t -nP -iTCP:"$port" -sTCP:LISTEN 2>/dev/null || true)"
                if [ -n "$listen_pids" ]; then
                    match_found=0
                    for pid in $listen_pids; do
                        proc_path="$(ps -o comm= -p "$pid" 2>/dev/null || true)"
                        if [ "$proc_path" = "$(brew --prefix)/bin/cld-gateway" ] \
                            || [ "$proc_path" = "$(brew --prefix cld-gateway)/bin/cld-gateway" ]; then
                            match_found=1
                        fi
                    done
                    if [ "$match_found" -ne 1 ]; then
                        echo "[FAIL] A different process is already listening on $host:$port"
                        critical_exit_code=1
                    fi
                fi
            fi

            if curl --fail --silent --show-error --max-time 10 "$health_url" >/dev/null 2>&1; then
                echo "[OK] Health endpoint responded at $health_url"
            else
                echo "[FAIL] Health check failed at $health_url"
                critical_exit_code=1
            fi
        fi
    fi

    if [ $critical_exit_code -eq 0 ]; then
        echo "==> Installation check passed"
        exit 0
    else
        echo "==> Installation check failed (required checks failed)" >&2
        exit 1
    fi
}

# Invoke main
main "$@"
